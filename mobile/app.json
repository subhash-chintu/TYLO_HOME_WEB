{
  "expo": {
    "name": "TYLO HOME",
    "slug": "tylo-home",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.tylohome.catalog",
      "icon": "./assets/logo.jpeg",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpeg",
        "backgroundColor": "#090909"
      }
    },
    "plugins": [
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.tylohome.catalog",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "95d5580b-e598-49a8-a615-c02644598a02"
      }
    }
  }
}
